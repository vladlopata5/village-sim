extends SceneTree
const LocalResources = preload("res://scripts/resource_container.gd")
const Resources = preload("res://scripts/resource_type.gd")
const Buildings = preload("res://scripts/building_type.gd")
const Profession = preload("res://scripts/resident_profession.gd")
const Activity = preload("res://scripts/resident_activity.gd")
const FOOD = Resources.Type.FOOD
var failures := 0
func _initialize() -> void:
	call_deferred("_run")
func check(condition: bool, message: String) -> void:
	if not condition:
		failures += 1
		push_error(message)
func _run() -> void:
	check_shared_inbound()
	var source = LocalResources.new(&"source")
	var destination = LocalResources.new(&"destination")
	check(not source.add(FOOD, 1), "Unconfigured capacity is zero")
	source.set_capacity(FOOD, 20)
	destination.set_capacity(FOOD, 5)
	source.add(FOOD, 5)
	destination.add(FOOD, 3)
	check(source.reserve_out(FOOD, 2) and source.get_available_amount(FOOD) == 3 and source.get_amount(FOOD) == 5, "Outgoing reserve retains physical stock")
	check(not source.reserve_out(FOOD, 4) and not source.try_take(FOOD, 4), "Second task and ordinary consumer cannot steal reserved stock")
	check(destination.reserve_in(FOOD, 2) and destination.get_free_capacity(FOOD) == 2 and destination.get_available_free_capacity(FOOD) == 0, "Incoming reserve retains physical free space")
	check(not destination.reserve_in(FOOD, 1) and not destination.add(FOOD, 1), "Second task and ordinary addition cannot fill promised space")
	check(not destination.set_capacity(FOOD, 4), "Capacity cannot shrink below promised space")
	check(source.take_reserved(FOOD, 2) and source.get_amount(FOOD) == 3 and source.get_reserved_out(FOOD) == 0, "Reserved withdrawal changes stock exactly once")
	check(not source.take_reserved(FOOD, 2), "Completed reservation cannot be consumed twice")
	check(destination.get_amount(FOOD) == 3, "Withdrawal does not teleport resource to destination")
	check(destination.add_reserved(FOOD, 2) and destination.get_amount(FOOD) == 5 and destination.get_reserved_in(FOOD) == 0, "Reserved delivery fills promised capacity exactly once")
	check(not destination.add_reserved(FOOD, 2), "Completed incoming reserve cannot be used twice")
	check(source.reserve_out(FOOD, 2) and source.release_out(FOOD, 1) and source.get_reserved_out(FOOD) == 1, "Partial outgoing release")
	check(not source.release_out(FOOD, 2) and source.release_out(FOOD, 1), "Over-release rejected without changing reservation")
	destination.try_take(FOOD, 2)
	destination.reserve_in(FOOD, 2)
	check(destination.release_in(FOOD, 1) and not destination.release_in(FOOD, 2) and destination.release_in(FOOD, 1), "Incoming release protects counts")
	for amount in [0, -1]:
		check(not source.reserve_out(FOOD, amount) and not source.release_out(FOOD, amount) and not source.take_reserved(FOOD, amount), "Invalid outgoing operations rejected")
		check(not destination.reserve_in(FOOD, amount) and not destination.release_in(FOOD, amount) and not destination.add_reserved(FOOD, amount), "Invalid incoming operations rejected")
	check(not destination.add(FOOD, 3) and destination.get_amount(FOOD) == 3, "Overcapacity addition is atomic")
	var scene = preload("res://tests/domain_world.gd").instantiate()
	root.add_child(scene)
	preload("res://tests/resident_test_setup.gd").isolate_first(scene)
	scene.game_time.set_process(false)
	scene.resident_runtimes[0].view.set_process(false)
	var warehouse = scene.warehouse_data
	var kitchen = scene.kitchen_data
	check(warehouse.type == Buildings.Type.STORAGE and warehouse.id == &"warehouse_01" and warehouse.display_name == "Склад", "Warehouse building data")
	check(warehouse.resources.get_amount(FOOD) == 10 and warehouse.resources.get_capacity(FOOD) == 20, "Warehouse starts 10 of 20")
	check(kitchen.resources.get_amount(FOOD) == 0 and kitchen.resources.get_capacity(FOOD) == 20, "Kitchen starts empty with capacity 20")
	check(scene.warehouse_data.resources.get_amount(FOOD) == 10 and scene.kitchen_data.resources.get_amount(FOOD) == 0, "UI reads separate stock")
	var view = scene.get_node("World/Warehouse")
	check(view.building_data == warehouse and scene.world_locations.get_location(warehouse.id).display_name == "Склад", "Warehouse view and distinct place registered")
	check(view.building_data == warehouse, "Warehouse placeholder visible and labelled")
	view.position += Vector2(10, 0)
	check(scene.world_locations.get_position(warehouse.id) == view.global_position, "Warehouse uses existing position mapping")
	check(scene.residents[0].profession == Profession.Type.PORTER, "Stepan assigned PORTER")
	scene.resident_selection.select(scene.residents[0])
	var card = scene.resident_card_view()
	card._refresh()
	check(card.profession_label.text == "Профессия: Носильщик", "Card translates assigned profession")
	scene.residents[0].hunger = 75
	scene.resident_runtimes[0].view._process(20.0)
	scene.game_time.advance(5.0)
	check(scene.residents[0].activity == Activity.Type.IDLE and scene.residents[0].hunger == 75 and warehouse.resources.get_amount(FOOD) == 10, "Empty kitchen cannot eat warehouse stock; no logistics behavior")
	kitchen.resources.add(FOOD, 1)
	check(scene.kitchen_data.resources.get_amount(FOOD) == 1 and scene.warehouse_data.resources.get_amount(FOOD) == 10, "Independent UI updates")
	view.free()
	check(warehouse.resources.get_amount(FOOD) == 10, "Warehouse data survives view removal")
	scene.free()
	print("Reservation checks: ", "PASS" if failures == 0 else "FAIL (%d)" % failures)
	quit(0 if failures == 0 else 1)

func check_shared_inbound() -> void:
	const R = Resources.Type
	var stock = LocalResources.new(&"shared")
	stock.configure_warehouse(2,{R.LOG:1,R.FOOD:1})
	stock.add(R.LOG,1)
	var observed: Array = []
	stock.reservations_changed.connect(func(_resource):
		observed.append([stock.get_total_amount(),stock.get_total_reserved_in()])
		stock.set_quotas({R.LOG:2,R.FOOD:0})
		observed.append(stock.reserve_in(R.LOG,1)),CONNECT_ONE_SHOT)
	check(stock.reserve_in(R.FOOD,1) and observed==[[1,1],false],"Reservation commits before callback; changed quotas cannot reserve the same final place for another type")
	check(stock.get_reserved_in(R.FOOD)==1 and stock.add_reserved(R.FOOD,1) and stock.get_amount(R.FOOD)==1,"Accepted inbound survives quota reduction inside callback")
	check(stock.get_total_amount()==2 and stock.get_total_reserved_in()==0 and not stock.reserve_in(R.LOG,1),"Grandfathered delivery still occupies shared physical capacity")
	var promised = LocalResources.new(&"promised")
	promised.configure_warehouse(3,{R.LOG:1,R.FOOD:2})
	check(promised.reserve_in(R.LOG,1) and promised.reserve_in(R.FOOD,1),"Different resources reserve separate shared places")
	check(promised.set_quotas({R.LOG:0,R.FOOD:0}),"Quotas may fall below all incoming promises")
	check(promised.release_in(R.LOG,1) and promised.get_reserved_in(R.FOOD)==1 and promised.get_total_reserved_in()==1,"Rollback releases only the requested inbound amount")
	check(not promised.release_in(R.LOG,1) and promised.add_reserved(R.FOOD,1) and not promised.add_reserved(R.FOOD,1),"Repeated rollback/delivery cannot consume another promise or duplicate stock")
	check(promised.get_amount(R.FOOD)==1 and promised.get_available_free_capacity(R.FOOD)==0,"Existing over-quota stock blocks fresh inbound")
	# Exercise the existing owner ledgers; the container must not introduce a second one.
	var origin = preload("res://scripts/building_data.gd").new(&"supply","Supply",Buildings.Type.GATHERER_HUT)
	origin.resources.set_capacity(R.FOOD,5)
	origin.resources.add(R.FOOD,2)
	var destination = preload("res://scripts/building_data.gd").new(&"store","Store",Buildings.Type.STORAGE)
	destination.resources.configure_warehouse(2,{R.FOOD:2})
	var first = preload("res://scripts/resident_data.gd").new("first","First",30,Profession.Type.PORTER)
	var second = preload("res://scripts/resident_data.gd").new("second","Second",30,Profession.Type.PORTER)
	first.work_location_id=destination.id
	second.work_location_id=destination.id
	var logistics = preload("res://scripts/logistics_controller.gd").new()
	logistics.position_provider=func(_id): return Vector2.ZERO
	logistics.setup(origin,destination,first)
	logistics.register_resident(second)
	var first_job = logistics.claim_best_job(first.id)
	var second_job = logistics.claim_best_job(second.id)
	check(first_job!=null and second_job!=null and destination.resources.get_reserved_in(R.FOOD)==2,"Two real jobs own separate inbound and outbound promises")
	if first_job==null or second_job==null: return
	destination.resources.set_quotas({R.FOOD:0,R.LOG:2})
	check(logistics.inbound_valid(first_job) and logistics.inbound_valid(second_job) and logistics.delivery_allowed(second_job),"Quota edit does not invalidate confirmed job admission")
	check(logistics.cancel_job(first_job) and not logistics.cancel_job(first_job) and logistics.inbound_valid(second_job),"Cancelling one owner leaves the other inbound valid, including repeated cancel")
	check(origin.resources.get_reserved_out(R.FOOD)==1 and destination.resources.get_reserved_in(R.FOOD)==1,"Owner rollback preserves exactly the other job's reservations")
	check(logistics.sources.pickup(second_job.source_ref,R.FOOD,second_job.id) and logistics.deliver_inbound(second_job),"Existing pickup/delivery adapters complete accepted shipment after quota becomes zero")
	check(not logistics.deliver_inbound(second_job) and destination.resources.get_amount(R.FOOD)==1 and destination.resources.get_total_reserved_in()==0 and origin.resources.get_reserved_out(R.FOOD)==0,"Inbound ownership is consumed once without leaks or duplicates")
	logistics.finish_job(second_job)
