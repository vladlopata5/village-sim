extends "res://tests/test_multi_recipe_production.gd"
const UI = preload("res://tests/residents_ui_fixture.gd")
var ui_observer: Callable
func observe_ui(world: Node, label: String) -> void:
	if ui_observer.is_valid(): await ui_observer.call(world,label)
func open_card(world: Node, target: RefCounted) -> Node:
	world.resident_selection.select_building(target)
	world.game_ui.info_panel.set_expanded(true)
	world.game_ui.info_panel.select_tab(&"production")
	return world.building_card_view()
func draft(view: Node, mode_id: int, text: String = "0") -> void:
	view.mode.select(mode_id)
	view.mode.item_selected.emit(mode_id)
	view.amount.text=text
	view.amount.text_changed.emit(text)
func apply(view: Node, mode_id: int, text: String = "0") -> void:
	draft(view,mode_id,text)
	view.apply_button.pressed.emit()
func refresh_card(card: Node) -> void: card._process(0.3)
func resource_snapshot(target: RefCounted) -> Array:
	var result: Array=[]
	for resource in Resources.values():result.append([target.resources.get_amount(resource),target.resources.get_reserved_in(resource),target.resources.get_reserved_out(resource)])
	return result
func real_cards() -> void:
	var world=UI.create(self)
	var saw=UI.building(world,Types.SAWMILL,Vector3(-13,0,0))
	var kitchen=UI.building(world,Types.FOOD,Vector3(-10,0,-10))
	kitchen.consumable_receivers[&"fuel"].reserve_in(Resources.LOG,4)
	kitchen.consumable_receivers[&"fuel"].add_reserved(Resources.LOG,4)
	var card=open_card(world,saw)
	var saw_view=card.recipe_views[&"sawmill_plank"]
	check(card.recipe_views.size()==1 and saw_view.mode.selected==Mode.UNLIMITED and not saw_view.amount.visible,"Real sawmill starts with one unlimited recipe")
	check(saw_view.composition.text.contains("Бревно ×1") and saw_view.composition.text.contains("Доски ×1") and saw_view.composition.text.contains("30 рабочих минут"),"Actual sawmill composition and duration")
	var actor=world.resident_runtimes[1]
	check(world.player_control.assign_workplace(actor.data.id,saw.id) and card.staffing_buttons.has(Profession.SAWYER),"Existing sawyer staffing remains available")
	saw.resources.add(Resources.LOG,1)
	apply(saw_view,Mode.ORDER,"1")
	check(world._request_work(actor),"Sawmill UI order enables actual worker task");walk(actor)
	world.game_time.debug_skip_minutes(9);refresh_card(card)
	check(saw_view.batches.text.contains("9 / 30") and not card.production_section.visible,"Sawmill shows its actual independent batch, not the old aggregate")
	await observe_ui(world,"sawmill-order")
	actor.commands.move_to(Vector2(0,500));actor.commands.cancel_current();actor.intents.abort_current(actor.intents.current_intent)
	card=open_card(world,kitchen)
	var view=card.recipe_views[&"fried_mushroom"]
	check(card.recipe_views.size()==2 and view.mode.selected==Mode.UNLIMITED,"Kitchen starts with its own unlimited fried recipe")
	check(view.composition.text.contains("Грибы ×1") and view.composition.text.contains("Жареные грибы ×2") and view.composition.text.contains("30 рабочих минут"),"Kitchen inputs, concrete output and work duration")
	check(world.player_control.assign_workplace(actor.data.id,kitchen.id) and card.staffing_buttons.has(Profession.COOK),"Existing COOK staffing remains available")
	kitchen.resources.add(Resources.MUSHROOM,3)
	apply(view,Mode.OFF)
	check(kitchen.get_recipe_mode(&"fried_mushroom")==Mode.OFF and not world._request_work(actor),"OFF UI command prevents new actual kitchen work")
	apply(view,Mode.UNLIMITED)
	check(world._request_work(actor),"Unlimited UI restores actual production");walk(actor)
	var paid=actor.recipe_work.batch
	world.game_time.debug_skip_minutes(8);refresh_card(card)
	check(view.batches.text.contains("Жареные грибы ×2") and view.batches.text.contains("Производится: 8 / 30") and view.batches.text.count("Производится")==1,"One paid batch shows its full two-unit output and one progress")
	apply(view,Mode.OFF)
	check(actor.recipe_work.batch==paid and paid.progress==8 and paid.inputs_spent and view.batches.visible,"OFF preserves and displays paid work")
	actor.commands.move_to(Vector2(0,500));refresh_card(card)
	check(paid.state==Batch.State.PAUSED and view.batches.text.contains("Приостановлено: 8 / 30"),"Paused paid batch remains visible even when recipe is OFF")
	await observe_ui(world,"kitchen-off-paused")
	actor.commands.cancel_current();actor.intents.abort_current(actor.intents.current_intent)
	check(world._request_work(actor),"Paid OFF work can resume under original F5 rules");walk(actor)
	world.game_time.debug_skip_minutes(22);refresh_card(card)
	check(kitchen.production_batches.is_empty() and kitchen.resources.get_amount(Resources.FRIED_MUSHROOM)==2 and not view.batches.visible,"Completed batch disappears without a phantom active row")
	apply(view,Mode.MAINTAIN,"0")
	check(kitchen.get_recipe_settings(&"fried_mushroom").target==0 and not kitchen.can_start_production(&"fried_mushroom"),"Zero maintain is a valid local target")
	apply(view,Mode.MAINTAIN,"10")
	check(view.status.text.contains("Поддерживать: 10 (в этом здании)"),"Maintain clearly refers to local building stock")
	await observe_ui(world,"kitchen-maintain")
	for invalid in ["-1","1.5","abc","99999999999999999999"]:
		var before=kitchen.get_recipe_settings(&"fried_mushroom")
		apply(view,Mode.ORDER,invalid)
		check(kitchen.get_recipe_settings(&"fried_mushroom")==before and view.amount.text==invalid and view.feedback.text.contains("целое"),"Invalid numeric input preserves state and draft: "+invalid)
	await observe_ui(world,"kitchen-invalid")
	apply(view,Mode.ORDER,"3")
	var revision: int=kitchen.production_revision
	var settings=kitchen.get_recipe_settings(&"fried_mushroom")
	var before_stock: int=kitchen.resources.get_amount(Resources.MUSHROOM)
	var cursor: Dictionary=kitchen._recipe_cursors.duplicate()
	var balances:=resource_snapshot(kitchen)
	for n in range(40):card._refresh();card._process(0.3)
	check(kitchen.production_revision==revision and kitchen.get_recipe_settings(&"fried_mushroom")==settings and kitchen.resources.get_amount(Resources.MUSHROOM)==before_stock and kitchen._recipe_cursors==cursor,"Repeated reads issue no orders, batches, input spend or cursor updates")
	check(kitchen.production_batches.is_empty() and world.logistics.jobs.is_empty() and resource_snapshot(kitchen)==balances,"Opening or refreshing UI creates no tasks or resource/reservation changes")
	var old_view=view
	open_card(world,saw);old_view._apply()
	card=open_card(world,kitchen);view=card.recipe_views[&"fried_mushroom"]
	check(kitchen.production_revision==revision and kitchen.get_order_remaining(&"fried_mushroom")==3 and saw.get_order_remaining(&"sawmill_plank")==1,"Reopen and stale widget callbacks do not reissue or cross-apply ORDER")
	check(not saw.production_changed.is_connected(card._refresh_recipes) and not saw.resources.changed.is_connected(card._on_resources_changed),"Old building local subscriptions are released")
	var first=take(kitchen,"domain_first")
	done(kitchen,first,"domain_first");refresh_card(card)
	check(view.status.text.contains("Произведено: 2") and view.status.text.contains("Осталось: 1"),"Successful output updates actual produced and remaining")
	kitchen.resources.try_take(Resources.FRIED_MUSHROOM,kitchen.resources.get_available_amount(Resources.FRIED_MUSHROOM))
	check(kitchen.get_order_remaining(&"fried_mushroom")==1 and view.status.text.contains("Осталось: 1"),"Removing output never restores order remainder")
	var second=take(kitchen,"domain_second")
	done(kitchen,second,"domain_second");refresh_card(card)
	check(view.mode.selected==Mode.OFF and view.status.text.contains("Заказ: 3") and view.status.text.contains("Произведено: 4") and view.status.text.contains("Осталось: 0") and view.status.text.contains("Превышение: 1"),"Completed ORDER automatically displays OFF and excess without reissuing")
	await observe_ui(world,"kitchen-order-completed-excess")
	kitchen.resources.add(Resources.MUSHROOM,1)
	apply(view,Mode.ORDER,"1")
	var editing_batch=take(kitchen,"editing")
	view.amount.text="8";view.amount.text_changed.emit("8");view.amount.grab_focus();view.amount.caret_column=1
	done(kitchen,editing_batch,"editing");refresh_card(card)
	check(kitchen.get_recipe_mode(&"fried_mushroom")==Mode.OFF and view.status.text.contains("Режим: Выключено") and view.amount.text=="8" and view.amount.visible and view.amount.has_focus() and view.amount.caret_column==1,"Automatic OFF shows actual state without hiding unfinished new-order input")
	var finished_revision: int=kitchen.production_revision
	open_card(world,saw);open_card(world,kitchen)
	check(kitchen.production_revision==finished_revision and card.recipe_views[&"fried_mushroom"].mode.selected==Mode.OFF,"Reopen discards only draft, never revives completed ORDER")
	for n in range(5):open_card(world,saw);open_card(world,kitchen)
	view=card.recipe_views[&"fried_mushroom"]
	check(kitchen.production_changed.get_connections().filter(func(c):return c.callable==card._refresh_recipes).size()==1,"Repeated selections keep exactly one local production subscription")
	apply(view,Mode.UNLIMITED)
	draft(view,Mode.MAINTAIN,"123")
	view.amount.grab_focus();view.amount.caret_column=1
	var same_editor=view.amount
	var same_section=view.get_instance_id()
	kitchen.resources.add(Resources.MUSHROOM,1)
	var batch=take(kitchen,"draft_worker");batch.advance("draft_worker",7);refresh_card(card)
	check(view.amount.text=="123" and view.amount.has_focus() and view.amount.caret_column==1 and view.amount==same_editor and view.get_instance_id()==same_section,"Progress/resource changes preserve draft, focus, caret and existing nodes")
	check(kitchen.get_recipe_mode(&"fried_mushroom")==Mode.UNLIMITED,"Draft selection/text do not apply until confirmation")
	kitchen.set_recipe_mode(&"fried_mushroom",Mode.OFF)
	check(view.status.text.contains("Режим: Выключено") and view.amount.text=="123" and batch.progress==7,"External mode updates actual state without destroying draft or paid work")
	view.amount.text="4";view.amount.text_changed.emit("4")
	UI.key(self,KEY_ENTER);await process_frame
	check(kitchen.get_recipe_mode(&"fried_mushroom")==Mode.MAINTAIN and kitchen.get_recipe_settings(&"fried_mushroom").target==4,"Real Enter input submits existing command path")
	apply(view,Mode.ORDER,"0")
	check(batch.inputs_spent and batch.progress==7 and not batch.is_terminal(),"New zero order preserves paid WIP without resetting progress")
	done(kitchen,batch,"draft_worker");refresh_card(card)
	check(view.mode.selected==Mode.OFF and kitchen.get_recipe_settings(&"fried_mushroom").produced==2 and kitchen.get_recipe_settings(&"fried_mushroom").excess==2,"Paid excess follows F5 order accounting")
	var stale=view
	world.player_control.unregister_building(kitchen.id)
	stale._apply()
	check(world.resident_selection.selected_building==null and card.recipe_views.is_empty() and not kitchen.production_changed.is_connected(card._refresh_recipes),"Removing selected building clears controls and all production subscriptions")
	check(not world.player_control.set_production_recipe(kitchen.id,&"fried_mushroom",Mode.ORDER,3).ok,"Removed target rejects player production commands")
	world.free()
func multiple_cards() -> void:
	var world=scene()
	var target=physical_building(world)
	var card=open_card(world,target)
	check(card.recipe_views.size()==3,"Three F5 test recipes have separate sections")
	var a=card.recipe_views[A];var b=card.recipe_views[B];var c=card.recipe_views[C]
	apply(a,Mode.ORDER,"5");apply(b,Mode.ORDER,"4");apply(c,Mode.UNLIMITED)
	draft(b,Mode.ORDER,"19");apply(a,Mode.ORDER,"3")
	check(target.get_order_remaining(A)==3 and target.get_order_remaining(B)==4 and b.amount.text=="19","ORDER commands and unfinished input remain independent for two recipes")
	apply(b,Mode.MAINTAIN,"4")
	draft(b,Mode.ORDER,"19")
	apply(a,Mode.ORDER,"3")
	check(b.amount.text=="19" and target.get_recipe_mode(B)==Mode.MAINTAIN and target.get_recipe_settings(B).target==4,"Recipe A command leaves recipe B actual settings and unfinished draft intact")
	apply(a,Mode.ORDER,"1");apply(b,Mode.MAINTAIN,"1")
	var ba=take(target,"a");ba.advance("a",3)
	var bb=take(target,"b");bb.advance("b",6)
	var bc=take(target,"c");bc.advance("c",5);bc.release_worker("c")
	refresh_card(card)
	check(a.batches.text.contains("Производится: 3 / 10") and b.batches.text.contains("Производится: 6 / 20") and c.batches.text.contains("Приостановлено: 5 / 15"),"Three independent parties show separate real states/times")
	var ids: Array=card.recipe_views.values().map(func(view):return view.get_instance_id())
	var cursor=target._recipe_cursors.duplicate();var revision: int=target.production_revision
	for n in range(50):card._refresh()
	check(ids==card.recipe_views.values().map(func(view):return view.get_instance_id()) and target._recipe_cursors==cursor and target.production_revision==revision,"Multi-recipe updates rebuild no sections or production cursor")
	await observe_ui(world,"multi-recipes-top")
	card.get_node("%Scroll").scroll_vertical=10000
	await observe_ui(world,"multi-recipes-bottom")
	var other=Building.new(&"multi_other",target.definition,Vector2(0,0))
	world.player_control.register_building(other)
	open_card(world,other)
	check(card.recipe_views[A].mode.selected==Mode.UNLIMITED and card.recipe_views[B].amount.text=="0" and target.get_order_remaining(A)==1,"Same building type has independent settings and no foreign draft")
	var revisions: int=card.refresh_count
	target.set_recipe_mode(A,Mode.OFF)
	check(card.refresh_count==revisions and card.recipe_views[A].mode.selected==Mode.UNLIMITED,"Previous building notification cannot change another open card")
	await observe_ui(world,"switch-building")
	stock(other)
	for id in [B,C]:apply(card.recipe_views[id],Mode.OFF)
	apply(card.recipe_views[A],Mode.ORDER,"3")
	var same_a=take(other,"same_a");var same_b=take(other,"same_b");var same_c=take(other,"same_c")
	same_a.advance("same_a",1);same_b.advance("same_b",2);same_c.advance("same_c",3);same_c.release_worker("same_c")
	refresh_card(card)
	var progress: String=card.recipe_views[A].batches.text
	check(progress.split("\n").size()==3 and progress.contains("1 / 10") and progress.contains("2 / 10") and progress.contains("Приостановлено: 3 / 10"),"Three batches of one recipe keep independent rows instead of aggregate progress")
	await observe_ui(world,"same-recipe-three-batches")

	world.resident_selection.clear()
	check(not other.production_changed.is_connected(card._refresh_recipes) and card.recipe_views.is_empty(),"Closing card disconnects and releases recipe widgets")
	world.free()
func validation() -> void:
	var world=UI.create(self)
	var kitchen=UI.building(world,Types.FOOD,Vector3(-10,0,-10))
	var card=open_card(world,kitchen);var control=world.player_control
	for id in [&"missing",null,3,true]:check(not control.set_production_recipe(kitchen.id,id,Mode.OFF).ok,"Unknown/invalid recipe identity is rejected")
	for mode_value in [-1,99,true,1.0,"1"]:check(not control.set_production_recipe(kitchen.id,&"fried_mushroom",mode_value).ok,"Mode validates actual integer enum")
	for amount_value in [-1,true,1.5,"2",null]:check(not control.set_production_recipe(kitchen.id,&"fried_mushroom",Mode.ORDER,amount_value).ok,"Amount validates integer nonnegative value")
	check(not control.set_production_recipe(kitchen.id,&"fried_mushroom",Mode.OFF,3).ok and kitchen.get_recipe_mode(&"fried_mushroom")==Mode.UNLIMITED,"Bad API calls leave production unchanged")
	var construction=Building.new(&"unbuilt",Definitions.for_type(Types.SAWMILL),Vector2.ZERO,Building.State.UNDER_CONSTRUCTION)
	control.register_building(construction);open_card(world,construction)
	check(card.recipe_views.is_empty() and not control.set_production_recipe(construction.id,&"sawmill_plank",Mode.ORDER,1).ok,"Construction has no usable recipe controls")
	var hut=UI.building(world,Types.GATHERER_HUT,Vector3(-10,0,-18));open_card(world,hut)
	check(card.recipe_views.is_empty() and card.production_section.visible,"Gatherer retains its extraction display without recipe controls")
	var town=world.warehouse_data
	world.resident_selection.select_building(town)
	world.game_ui.info_panel.select_tab(&"storage")
	check(card.recipe_views.is_empty() and card.storage_rows.size()==15 and card.get_node("%StorageSummary").text.contains("Занято: 30 / 100"),"Concrete textile categories are added; existing warehouse stock unaffected")
	world.free()
func run() -> void:
	root.size=Vector2i(1280,720)
	await real_cards()
	await multiple_cards()
	validation()
	print("Production UI: %d checks, %d failures" % [checks,failures])
	quit(1 if failures else 0)
