{
  "schema_version": 1,
  "definitions": [
    {
      "schema_version": 1,
      "id": "social.success_admiration",
      "revision": 3,
      "enabled": true,
      "trigger": "social.resolved",
      "main_role": "actor",
      "roles": {
        "actor": {
          "type": "resident",
          "from": "ctx.actor",
          "active_required": true
        },
        "other": {
          "type": "resident",
          "from": "ctx.other",
          "active_required": true,
          "different_from": [
            "actor"
          ]
        }
      },
      "when": {
        "eq": [
          {
            "ctx": "payload.reaction_1"
          },
          "POSITIVE"
        ]
      },
      "weight": 1,
      "cooldown": {
        "minutes": 240,
        "scope": [
          {
            "role": "actor"
          },
          {
            "role": "other"
          }
        ]
      },
      "effects": [
        {
          "op": "moodlet.add",
          "owner": {
            "role": "actor"
          },
          "definition": "admiration",
          "tags": [
            "positive",
            "social",
            "skill"
          ],
          "target": {
            "role": "other"
          },
          "duration_minutes": 120,
          "context": {
            "skill": {
              "binding": "skill"
            },
            "pride_moodlet_id": {
              "field": [
                {
                  "binding": "success"
                },
                "id"
              ]
            }
          },
          "modifiers": [],
          "chance": 0.4
        },
        {
          "op": "memory.add",
          "owner": {
            "role": "actor"
          },
          "kind": "admiration",
          "topic": "social",
          "tags": [
            "social"
          ],
          "context": {
            "skill": {
              "binding": "skill"
            }
          },
          "target": {
            "role": "other"
          },
          "text": "Я восхищаюсь успехами {other.name:gen} в навыке «{skill_name}». Вот пример для меня!",
          "chance": 0.7,
          "strength": 25,
          "permanent": false,
          "provenance": {
            "kind": "experienced"
          }
        }
      ],
      "text": {
        "chronicle": "{actor.name} {actor.gender:восхитился|восхитилась} успехами {other.name:gen} в навыке «{skill_name}»."
      },
      "bind": [
        {
          "as": "success",
          "select": {
            "from": {
              "fact": [
                {
                  "role": "other"
                },
                "moodlets.active"
              ]
            },
            "as": "candidate",
            "where": {
              "all": [
                {
                  "eq": [
                    {
                      "field": [
                        {
                          "local": "candidate"
                        },
                        "type"
                      ]
                    },
                    "pride"
                  ]
                },
                {
                  "any": [
                    {
                      "eq": [
                        {
                          "field": [
                            {
                              "field": [
                                {
                                  "field": [
                                    {
                                      "local": "candidate"
                                    },
                                    "context"
                                  ]
                                },
                                "_event"
                              ]
                            },
                            "definition_id"
                          ]
                        },
                        "personal.skill_progress"
                      ]
                    },
                    {
                      "eq": [
                        {
                          "field": [
                            {
                              "field": [
                                {
                                  "field": [
                                    {
                                      "local": "candidate"
                                    },
                                    "context"
                                  ]
                                },
                                "_event"
                              ]
                            },
                            "definition_id"
                          ]
                        },
                        "personal.skill_progress_advanced"
                      ]
                    }
                  ]
                }
              ]
            },
            "take": 1,
            "order_by": "id"
          }
        },
        {
          "as": "skill",
          "value": {
            "field": [
              {
                "field": [
                  {
                    "binding": "success"
                  },
                  "context"
                ]
              },
              "skill"
            ]
          }
        },
        {
          "as": "skill_name",
          "value": {
            "fact": [
              {
                "role": "other"
              },
              "skill.name",
              {
                "binding": "skill"
              }
            ]
          }
        }
      ]
    },
    {
      "schema_version": 1,
      "id": "social.warm_sympathy",
      "revision": 4,
      "enabled": true,
      "trigger": "social.resolved",
      "main_role": "other",
      "roles": {
        "actor": {
          "type": "resident",
          "from": "ctx.actor",
          "active_required": true
        },
        "other": {
          "type": "resident",
          "from": "ctx.other",
          "active_required": true,
          "different_from": [
            "actor"
          ]
        }
      },
      "when": {
        "all": [
          {
            "eq": [
              {
                "ctx": "payload.reaction_1"
              },
              "POSITIVE"
            ]
          },
          {
            "eq": [
              {
                "ctx": "payload.reaction_2"
              },
              "POSITIVE"
            ]
          }
        ]
      },
      "weight": 1,
      "cooldown": {
        "minutes": 240,
        "scope": [
          {
            "role": "actor"
          },
          {
            "role": "other"
          }
        ],
        "symmetric": true
      },
      "effects": [
        {
          "op": "memory.add",
          "owner": {
            "role": "actor"
          },
          "kind": "pleasant_interaction",
          "topic": "social",
          "tags": [
            "social",
            "positive"
          ],
          "target": {
            "role": "other"
          },
          "strength": 30,
          "provenance": {
            "kind": "experienced"
          },
          "permanent": false,
          "text": {
            "param": "diary_text"
          },
          "text_bindings": {
            "speaker": {
              "role": "actor"
            },
            "partner": {
              "role": "other"
            }
          },
          "chance": 0.5
        },
        {
          "op": "memory.add",
          "owner": {
            "role": "other"
          },
          "kind": "pleasant_interaction",
          "topic": "social",
          "tags": [
            "social",
            "positive"
          ],
          "target": {
            "role": "actor"
          },
          "strength": 30,
          "provenance": {
            "kind": "experienced"
          },
          "permanent": false,
          "text": {
            "param": "diary_text"
          },
          "text_bindings": {
            "speaker": {
              "role": "other"
            },
            "partner": {
              "role": "actor"
            }
          },
          "chance": 0.5
        }
      ],
      "text": {
        "chronicle": [
          "{actor.name} и {other.name} приятно провели время вместе.",
          "{actor.name} и {other.name} нашли общий язык.",
          "Между {actor.name:ins} и {other.name:ins} возникла взаимная симпатия.",
          "Общение {actor.name:gen} и {other.name:gen} оставило у обоих приятное впечатление."
        ]
      },
      "params": {
        "diary_text": [
          "Мне было приятно провести время {partner.with}",
          "Кажется, мы {partner.with} неплохо ладим",
          "Сегодня общение {partner.with} оставило приятное впечатление",
          "Я {speaker.gender:обрадовался|обрадовалась} встрече {partner.with}",
          "Иногда достаточно просто побыть рядом {partner.with}",
          "Похоже, нам {partner.with} легко находить общий язык",
          "Не {speaker.gender:ожидал|ожидала}, что мне будет так легко общаться {partner.with}",
          "По-моему, {partner.name} — {partner.gender:приятный|приятная} {partner.gender:собеседник|собеседница}",
          "Встреча {partner.with} оставила у меня хорошие впечатления",
          "Сегодня мне понравилось, как мы {partner.with} поладили",
          "Рядом {partner.with} я {speaker.gender:чувствовал|чувствовала} себя спокойно",
          "Кажется, я {speaker.gender:нашёл|нашла} приятную компанию в лице {partner.name:gen}"
        ],
        "chat_text": [
          "{partner.With} приятно проводить время!",
          "Похоже, мы {partner.with} неплохо ладим!",
          "{partner.name} — {partner.gender:отличный|отличная} {partner.gender:собеседник|собеседница}!",
          "Вот бы почаще пересекаться {partner.with}!",
          "Не {speaker.gender:думал|думала}, что мы так быстро поладим!",
          "Похоже, {partner.name} меня понимает",
          "Вот с кем приятно проводить время — так это {partner.with}!",
          "Хорошая компания — уже половина хорошего дня!",
          "Рядом {partner.with} как-то легче",
          "Сегодня мне повезло с компанией!",
          "Надо будет ещё как-нибудь провести время {partner.with}",
          "Кажется, у нас {partner.with} много общего!"
        ]
      },
      "exclusive_groups": [
        {
          "id": "speaker",
          "chance": 0.25,
          "options": [
            {
              "op": "chat.say",
              "owner": {
                "role": "actor"
              },
              "text": {
                "param": "chat_text"
              },
              "text_bindings": {
                "speaker": {
                  "role": "actor"
                },
                "partner": {
                  "role": "other"
                }
              },
              "weight": 1
            },
            {
              "op": "chat.say",
              "owner": {
                "role": "other"
              },
              "text": {
                "param": "chat_text"
              },
              "text_bindings": {
                "speaker": {
                  "role": "other"
                },
                "partner": {
                  "role": "actor"
                }
              },
              "weight": 1
            }
          ]
        }
      ],
      "effect_groups": [
        {
          "id": "company",
          "chance": 0.5,
          "effects": [
            {
              "op": "moodlet.add",
              "owner": {
                "role": "actor"
              },
              "target": {
                "role": "other"
              },
              "definition": "pleasant_company",
              "duration_minutes": 120,
              "tags": [
                "social",
                "positive"
              ],
              "context": {
                "display_name": "Приятная компания"
              },
              "modifiers": [
                {
                  "channel": "mood.offset",
                  "value": 10
                }
              ]
            },
            {
              "op": "moodlet.add",
              "owner": {
                "role": "other"
              },
              "target": {
                "role": "actor"
              },
              "definition": "pleasant_company",
              "duration_minutes": 120,
              "tags": [
                "social",
                "positive"
              ],
              "context": {
                "display_name": "Приятная компания"
              },
              "modifiers": [
                {
                  "channel": "mood.offset",
                  "value": 10
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "schema_version": 1,
      "id": "social.rough_conversation",
      "revision": 3,
      "enabled": true,
      "trigger": "social.resolved",
      "main_role": "actor",
      "roles": {
        "actor": {
          "type": "resident",
          "from": "ctx.actor",
          "active_required": true
        },
        "other": {
          "type": "resident",
          "from": "ctx.other",
          "active_required": true,
          "different_from": [
            "actor"
          ]
        }
      },
      "when": {
        "all": [
          {
            "eq": [
              {
                "ctx": "payload.reaction_1"
              },
              "NEGATIVE"
            ]
          },
          {
            "eq": [
              {
                "ctx": "payload.reaction_2"
              },
              "NEGATIVE"
            ]
          },
          {
            "lte": [
              {
                "fact": [
                  {
                    "role": "actor"
                  },
                  "mood"
                ]
              },
              20
            ]
          }
        ]
      },
      "weight": 1,
      "cooldown": {
        "minutes": 120,
        "scope": [
          {
            "role": "actor"
          },
          {
            "role": "other"
          }
        ]
      },
      "effects": [
        {
          "op": "memory.add",
          "owner": {
            "role": "actor"
          },
          "kind": "unpleasant_interaction",
          "topic": "conversation",
          "tags": [
            "negative",
            "social",
            "grudge"
          ],
          "target": {
            "role": "other"
          },
          "strength": 45,
          "permanent": false,
          "provenance": {
            "kind": "experienced"
          },
          "context": {
            "interaction": {
              "ctx": "payload.interaction"
            }
          },
          "chance": 0.6,
          "text": [
            "Я {actor.gender:поссорился|поссорилась} {other.with}. Это было неприятно.",
            "После общения {other.with} у меня осталось неприятное впечатление.",
            "Мне тяжело вспоминать, как мы {other.with} поссорились."
          ]
        }
      ],
      "text": {
        "chronicle": "{actor.name} {actor.gender:поссорился|поссорилась} {other.with}."
      },
      "effect_groups": [
        {
          "id": "anger",
          "chance": 0.4,
          "effects": [
            {
              "op": "moodlet.add",
              "owner": {
                "role": "actor"
              },
              "definition": "angry",
              "duration_minutes": 120,
              "modifiers": []
            },
            {
              "op": "chat.say",
              "owner": {
                "role": "actor"
              },
              "text": [
                "{other.gender:Какой же|Какая же} {other.name} {other.gender:болван|дура}!",
                "{other.name} умеет испортить настроение!"
              ]
            }
          ]
        }
      ]
    },
    {
      "schema_version": 1,
      "id": "social.old_grudge",
      "revision": 3,
      "enabled": true,
      "trigger": "social.resolved",
      "main_role": "actor",
      "roles": {
        "actor": {
          "type": "resident",
          "from": "ctx.actor",
          "active_required": true
        },
        "other": {
          "type": "resident",
          "from": "ctx.other",
          "active_required": true,
          "different_from": [
            "actor"
          ]
        }
      },
      "when": {
        "eq": [
          {
            "ctx": "payload.reaction_1"
          },
          "NEGATIVE"
        ]
      },
      "weight": 1,
      "cooldown": {
        "minutes": 480,
        "scope": [
          {
            "role": "actor"
          },
          {
            "role": "other"
          }
        ]
      },
      "effects": [
        {
          "op": "memory.reinforce",
          "owner": {
            "role": "actor"
          },
          "entry_id": {
            "field": [
              {
                "binding": "grievance"
              },
              "id"
            ]
          },
          "expected_version": {
            "field": [
              {
                "binding": "grievance"
              },
              "_version"
            ]
          },
          "amount": 10,
          "chance": 1
        }
      ],
      "text": {
        "chronicle": "{actor.name} {actor.gender:вспомнил|вспомнила} прежний неприятный случай после общения {other.with}."
      },
      "bind": [
        {
          "as": "grievance",
          "select": {
            "from": {
              "fact": [
                {
                  "role": "actor"
                },
                "memories"
              ]
            },
            "as": "candidate",
            "where": {
              "all": [
                {
                  "has_tag": [
                    {
                      "local": "candidate"
                    },
                    "negative"
                  ]
                },
                {
                  "eq": [
                    {
                      "field": [
                        {
                          "local": "candidate"
                        },
                        "target"
                      ]
                    },
                    {
                      "role": "other"
                    }
                  ]
                },
                {
                  "gt": [
                    {
                      "field": [
                        {
                          "local": "candidate"
                        },
                        "strength"
                      ]
                    },
                    0
                  ]
                },
                {
                  "eq": [
                    {
                      "field": [
                        {
                          "field": [
                            {
                              "local": "candidate"
                            },
                            "provenance"
                          ]
                        },
                        "kind"
                      ]
                    },
                    "experienced"
                  ]
                },
                {
                  "lt": [
                    {
                      "field": [
                        {
                          "local": "candidate"
                        },
                        "created_minute"
                      ]
                    },
                    {
                      "ctx": "minute"
                    }
                  ]
                }
              ]
            },
            "take": 1,
            "order_by": "id"
          }
        }
      ]
    },
    {
      "schema_version": 1,
      "id": "social.character_contrast",
      "revision": 3,
      "enabled": true,
      "trigger": "social.resolved",
      "main_role": "actor",
      "roles": {
        "actor": {
          "type": "resident",
          "from": "ctx.actor",
          "active_required": true
        },
        "other": {
          "type": "resident",
          "from": "ctx.other",
          "active_required": true,
          "different_from": [
            "actor"
          ]
        }
      },
      "when": {
        "all": [
          {
            "eq": [
              {
                "ctx": "payload.interaction"
              },
              "CONVERSATION"
            ]
          },
          {
            "eq": [
              {
                "ctx": "payload.reaction_1"
              },
              "NEUTRAL"
            ]
          },
          {
            "exists": {
              "from": {
                "fact": [
                  {
                    "role": "actor"
                  },
                  "traits"
                ]
              },
              "as": "candidate",
              "where": {
                "eq": [
                  {
                    "local": "candidate"
                  },
                  "sociable"
                ]
              }
            }
          },
          {
            "exists": {
              "from": {
                "fact": [
                  {
                    "role": "other"
                  },
                  "traits"
                ]
              },
              "as": "candidate",
              "where": {
                "eq": [
                  {
                    "local": "candidate"
                  },
                  "introverted"
                ]
              }
            }
          }
        ]
      },
      "weight": 1,
      "cooldown": {
        "minutes": 240,
        "scope": [
          {
            "role": "actor"
          },
          {
            "role": "other"
          }
        ]
      },
      "effects": [
        {
          "op": "memory.add",
          "owner": {
            "role": "actor"
          },
          "kind": "character_contrast",
          "topic": "social",
          "tags": [
            "social"
          ],
          "context": {},
          "target": {
            "role": "other"
          },
          "text": "Мне приятно искать компанию. {other.name} — человек более замкнутый; похоже, у нас разные привычки в общении.",
          "chance": 0.7,
          "strength": 15,
          "permanent": false,
          "provenance": {
            "kind": "experienced"
          }
        }
      ],
      "text": {
        "chronicle": "{actor.name} и {other.name} пообщались, несмотря на различия в общительности."
      }
    },
    {
      "schema_version": 1,
      "id": "personal.skill_progress_advanced",
      "revision": 4,
      "enabled": true,
      "trigger": "skill.raised",
      "main_role": "actor",
      "roles": {
        "actor": {
          "type": "resident",
          "from": "ctx.actor",
          "active_required": true
        }
      },
      "params": {
        "minimum_rank": 2
      },
      "when": {
        "all": [
          {
            "gt": [
              {
                "ctx": "payload.new_rank"
              },
              {
                "ctx": "payload.previous_rank"
              }
            ]
          },
          {
            "gte": [
              {
                "ctx": "payload.new_rank"
              },
              {
                "param": "minimum_rank"
              }
            ]
          }
        ]
      },
      "weight": 1,
      "effects": [
        {
          "op": "moodlet.add",
          "owner": {
            "role": "actor"
          },
          "definition": "pride",
          "tags": [
            "achievement",
            "skill"
          ],
          "duration_minutes": 120,
          "context": {
            "skill": {
              "ctx": "payload.skill"
            },
            "new_rank": {
              "ctx": "payload.new_rank"
            }
          },
          "modifiers": [],
          "chance": 1
        },
        {
          "op": "memory.add",
          "owner": {
            "role": "actor"
          },
          "kind": "skill_progress_advanced",
          "topic": {
            "ctx": "payload.skill"
          },
          "tags": [
            "achievement",
            "skill"
          ],
          "context": {
            "skill": {
              "ctx": "payload.skill"
            },
            "new_rank": {
              "ctx": "payload.new_rank"
            }
          },
          "text": "Я горжусь достижением: новое звание в навыке «{payload.skill_name}» — «{payload.new_rank_name}».",
          "chance": 1,
          "strength": 50,
          "permanent": false,
          "provenance": {
            "kind": "experienced"
          }
        }
      ],
      "text": {
        "chronicle": "{actor.name} {actor.gender:достиг|достигла} звания «{payload.new_rank_name}» в навыке «{payload.skill_name}»."
      }
    }
  ]
}
