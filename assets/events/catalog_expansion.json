{
  "schema_version": 1,
  "definitions": [
    {
      "schema_version": 1,
      "id": "social.success_admiration",
      "revision": 2,
      "enabled": true,
      "trigger": "social.resolved",
      "main_role": "actor",
      "roles": {
        "actor": {
          "type": "resident",
          "from": "ctx.actor",
          "active_required": true
        },
        "other": {
          "type": "resident",
          "from": "ctx.other",
          "active_required": true,
          "different_from": [
            "actor"
          ]
        }
      },
      "when": {
        "eq": [
          {
            "ctx": "payload.reaction_1"
          },
          "POSITIVE"
        ]
      },
      "weight": 1,
      "diary_importance": 2,
      "cooldown": {
        "minutes": 240,
        "scope": [
          {
            "role": "actor"
          },
          {
            "role": "other"
          }
        ]
      },
      "effects": [
        {
          "op": "moodlet.add",
          "owner": {
            "role": "actor"
          },
          "definition": "admiration",
          "tags": [
            "positive",
            "social",
            "skill"
          ],
          "target": {
            "role": "other"
          },
          "duration_minutes": 120,
          "context": {
            "skill": {
              "binding": "skill"
            },
            "pride_moodlet_id": {
              "field": [
                {
                  "binding": "success"
                },
                "id"
              ]
            }
          },
          "modifiers": [],
          "chance": 0.4
        }
      ],
      "text": {
        "chronicle": "{actor.name} {actor.gender:восхитился|восхитилась} успехами {other.name:gen} в навыке «{skill_name}».",
        "diary_main": "Я восхищаюсь успехами {other.name:gen} в навыке «{skill_name}». Вот пример для меня!"
      },
      "bind": [
        {
          "as": "success",
          "select": {
            "from": {
              "fact": [
                {
                  "role": "other"
                },
                "moodlets.active"
              ]
            },
            "as": "candidate",
            "where": {
              "all": [
                {
                  "eq": [
                    {
                      "field": [
                        {
                          "local": "candidate"
                        },
                        "type"
                      ]
                    },
                    "pride"
                  ]
                },
                {
                  "any": [
                    {
                      "eq": [
                        {
                          "field": [
                            {
                              "field": [
                                {
                                  "field": [
                                    {
                                      "local": "candidate"
                                    },
                                    "context"
                                  ]
                                },
                                "_event"
                              ]
                            },
                            "definition_id"
                          ]
                        },
                        "personal.skill_progress"
                      ]
                    },
                    {
                      "eq": [
                        {
                          "field": [
                            {
                              "field": [
                                {
                                  "field": [
                                    {
                                      "local": "candidate"
                                    },
                                    "context"
                                  ]
                                },
                                "_event"
                              ]
                            },
                            "definition_id"
                          ]
                        },
                        "personal.skill_progress_advanced"
                      ]
                    }
                  ]
                }
              ]
            },
            "take": 1,
            "order_by": "id"
          }
        },
        {
          "as": "skill",
          "value": {
            "field": [
              {
                "field": [
                  {
                    "binding": "success"
                  },
                  "context"
                ]
              },
              "skill"
            ]
          }
        },
        {
          "as": "skill_name",
          "value": {
            "fact": [
              {
                "role": "other"
              },
              "skill.name",
              {
                "binding": "skill"
              }
            ]
          }
        }
      ]
    },
    {
      "schema_version": 1,
      "id": "social.warm_sympathy",
      "revision": 2,
      "enabled": true,
      "trigger": "social.resolved",
      "main_role": "other",
      "roles": {
        "actor": {
          "type": "resident",
          "from": "ctx.actor",
          "active_required": true
        },
        "other": {
          "type": "resident",
          "from": "ctx.other",
          "active_required": true,
          "different_from": [
            "actor"
          ]
        }
      },
      "when": {
        "all": [
          {
            "eq": [
              {
                "ctx": "payload.reaction_1"
              },
              "POSITIVE"
            ]
          },
          {
            "eq": [
              {
                "ctx": "payload.reaction_2"
              },
              "POSITIVE"
            ]
          }
        ]
      },
      "weight": 1,
      "diary_importance": 2,
      "cooldown": {
        "minutes": 240,
        "scope": [
          {
            "role": "actor"
          },
          {
            "role": "other"
          }
        ]
      },
      "effects": [],
      "text": {
        "chronicle": "{actor.name} и {other.name} приятно пообщались.",
        "diary_main": "Мне было приятно общаться {actor.with}. Кажется, мы хорошо поладили.",
        "diary_secondary": "Мне было приятно общаться {other.with}. Мы хорошо поладили."
      },
      "secondary_diary": {
        "role": "actor",
        "chance": 0.2
      }
    },
    {
      "schema_version": 1,
      "id": "social.rough_conversation",
      "revision": 2,
      "enabled": true,
      "trigger": "social.resolved",
      "main_role": "actor",
      "roles": {
        "actor": {
          "type": "resident",
          "from": "ctx.actor",
          "active_required": true
        },
        "other": {
          "type": "resident",
          "from": "ctx.other",
          "active_required": true,
          "different_from": [
            "actor"
          ]
        }
      },
      "when": {
        "all": [
          {
            "eq": [
              {
                "ctx": "payload.reaction_1"
              },
              "NEGATIVE"
            ]
          },
          {
            "eq": [
              {
                "ctx": "payload.reaction_2"
              },
              "NEGATIVE"
            ]
          },
          {
            "lte": [
              {
                "fact": [
                  {
                    "role": "actor"
                  },
                  "mood"
                ]
              },
              20
            ]
          }
        ]
      },
      "weight": 1,
      "diary_importance": 2,
      "cooldown": {
        "minutes": 120,
        "scope": [
          {
            "role": "actor"
          },
          {
            "role": "other"
          }
        ]
      },
      "effects": [
        {
          "op": "memory.add",
          "owner": {
            "role": "actor"
          },
          "kind": "unpleasant_interaction",
          "topic": "conversation",
          "tags": [
            "negative",
            "social",
            "grudge"
          ],
          "target": {
            "role": "other"
          },
          "strength": 30,
          "permanent": false,
          "provenance": {
            "kind": "experienced"
          },
          "context": {
            "interaction": {
              "ctx": "payload.interaction"
            }
          },
          "chance": 0.6
        }
      ],
      "text": {
        "chronicle": "{actor.name} {actor.gender:поссорился|поссорилась} {other.with}."
      },
      "effect_groups": [
        {
          "id": "anger",
          "chance": 0.4,
          "effects": [
            {
              "op": "moodlet.add",
              "owner": {
                "role": "actor"
              },
              "definition": "angry",
              "duration_minutes": 120,
              "modifiers": []
            },
            {
              "op": "chat.say",
              "owner": {
                "role": "actor"
              },
              "text": [
                "{other.gender:Какой же|Какая же} {other.name} {other.gender:болван|дура}!",
                "{other.name} умеет испортить настроение!"
              ]
            }
          ]
        }
      ]
    },
    {
      "schema_version": 1,
      "id": "social.old_grudge",
      "revision": 2,
      "enabled": true,
      "trigger": "social.resolved",
      "main_role": "actor",
      "roles": {
        "actor": {
          "type": "resident",
          "from": "ctx.actor",
          "active_required": true
        },
        "other": {
          "type": "resident",
          "from": "ctx.other",
          "active_required": true,
          "different_from": [
            "actor"
          ]
        }
      },
      "when": {
        "eq": [
          {
            "ctx": "payload.reaction_1"
          },
          "NEGATIVE"
        ]
      },
      "weight": 1,
      "diary_importance": 2,
      "cooldown": {
        "minutes": 480,
        "scope": [
          {
            "role": "actor"
          },
          {
            "role": "other"
          }
        ]
      },
      "effects": [],
      "text": {
        "chronicle": "{actor.name} {actor.gender:вспомнил|вспомнила} прежний неприятный случай после общения {other.with}.",
        "diary_main": "После общения {other.with} я {actor.gender:вспомнил|вспомнила} прежнюю неприятную историю."
      },
      "bind": [
        {
          "as": "grievance",
          "select": {
            "from": {
              "fact": [
                {
                  "role": "actor"
                },
                "memories"
              ]
            },
            "as": "candidate",
            "where": {
              "all": [
                {
                  "has_tag": [
                    {
                      "local": "candidate"
                    },
                    "negative"
                  ]
                },
                {
                  "eq": [
                    {
                      "field": [
                        {
                          "local": "candidate"
                        },
                        "target"
                      ]
                    },
                    {
                      "role": "other"
                    }
                  ]
                },
                {
                  "gt": [
                    {
                      "field": [
                        {
                          "local": "candidate"
                        },
                        "strength"
                      ]
                    },
                    0
                  ]
                },
                {
                  "eq": [
                    {
                      "field": [
                        {
                          "field": [
                            {
                              "local": "candidate"
                            },
                            "provenance"
                          ]
                        },
                        "kind"
                      ]
                    },
                    "experienced"
                  ]
                },
                {
                  "lt": [
                    {
                      "field": [
                        {
                          "local": "candidate"
                        },
                        "created_minute"
                      ]
                    },
                    {
                      "ctx": "minute"
                    }
                  ]
                }
              ]
            },
            "take": 1,
            "order_by": "id"
          }
        }
      ]
    },
    {
      "schema_version": 1,
      "id": "social.character_contrast",
      "revision": 2,
      "enabled": true,
      "trigger": "social.resolved",
      "main_role": "actor",
      "roles": {
        "actor": {
          "type": "resident",
          "from": "ctx.actor",
          "active_required": true
        },
        "other": {
          "type": "resident",
          "from": "ctx.other",
          "active_required": true,
          "different_from": [
            "actor"
          ]
        }
      },
      "when": {
        "all": [
          {
            "eq": [
              {
                "ctx": "payload.interaction"
              },
              "CONVERSATION"
            ]
          },
          {
            "eq": [
              {
                "ctx": "payload.reaction_1"
              },
              "NEUTRAL"
            ]
          },
          {
            "exists": {
              "from": {
                "fact": [
                  {
                    "role": "actor"
                  },
                  "traits"
                ]
              },
              "as": "candidate",
              "where": {
                "eq": [
                  {
                    "local": "candidate"
                  },
                  "sociable"
                ]
              }
            }
          },
          {
            "exists": {
              "from": {
                "fact": [
                  {
                    "role": "other"
                  },
                  "traits"
                ]
              },
              "as": "candidate",
              "where": {
                "eq": [
                  {
                    "local": "candidate"
                  },
                  "introverted"
                ]
              }
            }
          }
        ]
      },
      "weight": 1,
      "diary_importance": 2,
      "cooldown": {
        "minutes": 240,
        "scope": [
          {
            "role": "actor"
          },
          {
            "role": "other"
          }
        ]
      },
      "effects": [],
      "text": {
        "chronicle": "{actor.name} и {other.name} пообщались, несмотря на различия в общительности.",
        "diary_main": "Мне приятно искать компанию. {other.name} — человек более замкнутый; похоже, у нас разные привычки в общении."
      }
    },
    {
      "schema_version": 1,
      "id": "personal.skill_progress_advanced",
      "revision": 3,
      "enabled": true,
      "trigger": "skill.raised",
      "main_role": "actor",
      "roles": {
        "actor": {
          "type": "resident",
          "from": "ctx.actor",
          "active_required": true
        }
      },
      "params": {
        "minimum_rank": 2
      },
      "when": {
        "all": [
          {
            "gt": [
              {
                "ctx": "payload.new_rank"
              },
              {
                "ctx": "payload.previous_rank"
              }
            ]
          },
          {
            "gte": [
              {
                "ctx": "payload.new_rank"
              },
              {
                "param": "minimum_rank"
              }
            ]
          }
        ]
      },
      "weight": 1,
      "diary_importance": 2,
      "effects": [
        {
          "op": "moodlet.add",
          "owner": {
            "role": "actor"
          },
          "definition": "pride",
          "tags": [
            "achievement",
            "skill"
          ],
          "duration_minutes": 120,
          "context": {
            "skill": {
              "ctx": "payload.skill"
            },
            "new_rank": {
              "ctx": "payload.new_rank"
            }
          },
          "modifiers": [],
          "chance": 1
        }
      ],
      "text": {
        "chronicle": "{actor.name} {actor.gender:достиг|достигла} звания «{payload.new_rank_name}» в навыке «{payload.skill_name}».",
        "diary_main": "Я горжусь достижением: новое звание в навыке «{payload.skill_name}» — «{payload.new_rank_name}»."
      }
    }
  ]
}
