      "text": {
        "chronicle": [
          "{actor.name} и {other.name} приятно провели время вместе.",
          "{actor.name} и {other.name} нашли общий язык.",
          "Между {actor.name:ins} и {other.name:ins} возникла взаимная симпатия.",
          "Общение {actor.name:gen} и {other.name:gen} оставило у обоих приятное впечатление."
        ]
      },
      "params": {
        "diary_text": [
          "Мне было приятно провести время {partner.with}",
          "Кажется, мы {partner.with} неплохо ладим",
          "Сегодня общение {partner.with} оставило приятное впечатление",
          "Я {speaker.gender:обрадовался|обрадовалась} встрече {partner.with}",
          "Иногда достаточно просто побыть рядом {partner.with}",
          "Похоже, нам {partner.with} легко находить общий язык",
          "Не {speaker.gender:ожидал|ожидала}, что мне будет так легко общаться {partner.with}",
          "По-моему, {partner.name} — {partner.gender:приятный|приятная} {partner.gender:собеседник|собеседница}",
          "Встреча {partner.with} оставила у меня хорошие впечатления",
          "Сегодня мне понравилось, как мы {partner.with} поладили",
          "Рядом {partner.with} я {speaker.gender:чувствовал|чувствовала} себя спокойно",
          "Кажется, я {speaker.gender:нашёл|нашла} приятную компанию в лице {partner.name:gen}"
        ],
        "chat_text": [
          "{partner.With} приятно проводить время!",
          "Похоже, мы {partner.with} неплохо ладим!",
          "{partner.name} — {partner.gender:отличный|отличная} {partner.gender:собеседник|собеседница}!",
          "Вот бы почаще пересекаться {partner.with}!",
          "Не {speaker.gender:думал|думала}, что мы так быстро поладим!",
          "Похоже, {partner.name} меня понимает",
          "Вот с кем приятно проводить время — так это {partner.with}!",
          "Хорошая компания — уже половина хорошего дня!",
          "Рядом {partner.with} как-то легче",
          "Сегодня мне повезло с компанией!",
          "Надо будет ещё как-нибудь провести время {partner.with}",
          "Кажется, у нас {partner.with} много общего!"
        ]
      },
      "exclusive_groups": [
        {
          "id": "speaker",
          "chance": 0.25,
          "options": [
            {
              "op": "chat.say",
              "owner": {
                "role": "actor"
