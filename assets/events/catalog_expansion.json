            "role": "actor"
          },
          "entry_id": {
            "field": [
              {
                "binding": "grievance"
              },
              "id"
            ]
          },
          "expected_version": {
            "field": [
              {
                "binding": "grievance"
              },
              "_version"
            ]
          },
          "amount": 10,
          "chance": 1
        }
      ],
      "text": {
        "chronicle": "{actor.name} {actor.gender:вспомнил|вспомнила} прежний неприятный случай после общения {other.with}."
      },
      "bind": [
        {
          "as": "grievance",
          "select": {
            "from": {
              "fact": [
                {
                  "role": "actor"
                },
                "memories"
              ]
            },
            "as": "candidate",
            "where": {
              "all": [
                {
                  "has_tag": [
                    {
                      "local": "candidate"
                    },
                    "negative"
                  ]
                },
                {
                  "eq": [
                    {
                      "field": [
                        {
                          "local": "candidate"
                        },
                        "target"
                      ]
                    },
                    {
                      "role": "other"
                    }
                  ]
                },
                {
                  "gt": [
                    {
                      "field": [
                        {
                          "local": "candidate"
                        },
                        "strength"
                      ]
                    },
                    0
                  ]
                },
                {
                  "eq": [
                    {
                      "field": [
                        {
                          "field": [
                            {
                              "local": "candidate"
                            },
                            "provenance"
                          ]
                        },
                        "kind"
                      ]
                    },
                    "experienced"
                  ]
                },
                {
                  "lt": [
                    {
                      "field": [
                        {
                          "local": "candidate"
                        },
                        "created_minute"
                      ]
                    },
                    {
                      "ctx": "minute"
                    }
                  ]
                }
              ]
            },
            "take": 1,
            "order_by": "id"
          }
        }
      ]
    },
    {
