        {
          "op": "memory.add",
          "owner": {
            "role": "other"
          },
          "kind": "pleasant_interaction",
          "topic": "social",
          "tags": [
            "social",
            "positive"
          ],
          "target": {
            "role": "actor"
          },
          "strength": 30,
          "provenance": {
            "kind": "experienced"
          },
          "permanent": false,
          "text": {
            "param": "diary_text"
