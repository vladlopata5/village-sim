{
  "schema_version": 1,
  "definitions": [
    {
      "schema_version": 1,
      "id": "social.success_admiration",
      "revision": 3,
      "enabled": true,
      "trigger": "social.resolved",
      "main_role": "actor",
      "roles": {
        "actor": {
          "type": "resident",
          "from": "ctx.actor",
          "active_required": true
        },
        "other": {
          "type": "resident",
          "from": "ctx.other",
          "active_required": true,
          "different_from": [
            "actor"
          ]
        }
      },
      "when": {
        "eq": [
          {
            "ctx": "payload.reaction_1"
          },
          "POSITIVE"
        ]
      },
      "weight": 1,
      "cooldown": {
        "minutes": 240,
        "scope": [
          {
            "role": "actor"
          },
          {
            "role": "other"
          }
        ]
      },
      "effects": [
        {
          "op": "moodlet.add",
          "owner": {
            "role": "actor"
          },
          "definition": "admiration",
          "tags": [
            "positive",
            "social",
            "skill"
          ],
          "target": {
            "role": "other"
          },
          "duration_minutes": 120,
          "context": {
            "skill": {
              "binding": "skill"
            },
            "pride_moodlet_id": {
              "field": [
                {
                  "binding": "success"
                },
                "id"
              ]
            }
          },
          "modifiers": [],
          "chance": 0.4
        },
        {
          "op": "memory.add",
          "owner": {
            "role": "actor"
          },
          "kind": "admiration",
          "topic": "social",
          "tags": [
            "social"
          ],
          "context": {
            "skill": {
              "binding": "skill"
            }
          },
          "target": {
            "role": "other"
          },
          "text": "Я восхищаюсь успехами {other.name:gen} в навыке «{skill_name}». Вот пример для меня!",
          "chance": 0.7,
          "strength": 25,
          "permanent": false,
          "provenance": {
            "kind": "experienced"
          }
        }
      ],
      "text": {
        "chronicle": "{actor.name} {actor.gender:восхитился|восхитилась} успехами {other.name:gen} в навыке «{skill_name}»."
      },
      "bind": [
        {
          "as": "success",
          "select": {
            "from": {
              "fact": [
                {
                  "role": "other"
                },
                "moodlets.active"
              ]
            },
            "as": "candidate",
            "where": {
              "all": [
                {
                  "eq": [
                    {
                      "field": [
                        {
                          "local": "candidate"
                        },
                        "type"
                      ]
                    },
                    "pride"
                  ]
                },
                {
                  "any": [
                    {
                      "eq": [
                        {
                          "field": [
                            {
                              "field": [
                                {
                                  "field": [
                                    {
                                      "local": "candidate"
                                    },
                                    "context"
                                  ]
                                },
                                "_event"
                              ]
                            },
                            "definition_id"
                          ]
                        },
                        "personal.skill_progress"
                      ]
                    },
                    {
                      "eq": [
                        {
                          "field": [
                            {
                              "field": [
                                {
                                  "field": [
                                    {
                                      "local": "candidate"
                                    },
                                    "context"
                                  ]
                                },
                                "_event"
                              ]
                            },
                            "definition_id"
                          ]
                        },
                        "personal.skill_progress_advanced"
                      ]
                    }
                  ]
                }
              ]
            },
            "take": 1,
            "order_by": "id"
          }
        },
        {
          "as": "skill",
          "value": {
            "field": [
              {
                "field": [
                  {
                    "binding": "success"
                  },
                  "context"
                ]
              },
              "skill"
            ]
          }
        },
        {
          "as": "skill_name",
          "value": {
            "fact": [
              {
                "role": "other"
              },
              "skill.name",
              {
                "binding": "skill"
              }
            ]
          }
        }
      ]
    },
    {
