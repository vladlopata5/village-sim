{
  "schema_version": 1,
  "definitions": [
    {
      "schema_version": 1,
      "id": "personal.skill_progress",
      "revision": 5,
      "enabled": true,
      "trigger": "skill.raised",
      "main_role": "actor",
      "roles": {
        "actor": {
          "type": "resident",
          "from": "ctx.actor",
          "active_required": true
        }
      },
      "when": {
        "gt": [
          {
            "ctx": "payload.new_rank"
          },
          {
            "ctx": "payload.previous_rank"
          }
        ]
      },
      "weight": 1,
      "effects": [
        {
          "op": "memory.add",
          "owner": {
            "role": "actor"
          },
          "kind": "skill_progress",
          "topic": {
            "ctx": "payload.skill"
          },
          "tags": [
            "achievement",
            "skill"
          ],
          "strength": 30,
          "permanent": false,
          "provenance": {
            "kind": "experienced"
          },
          "context": {
            "skill": {
              "ctx": "payload.skill"
            },
            "previous_rank": {
              "ctx": "payload.previous_rank"
            },
            "new_rank": {
              "ctx": "payload.new_rank"
            }
          },
          "chance": 1,
          "text": "Я замечаю прогресс в навыке «{payload.skill_name}»: «{payload.previous_rank_name}» → «{payload.new_rank_name}»."
        },
        {
          "op": "moodlet.add",
          "owner": {
            "role": "actor"
          },
          "definition": "pride",
          "tags": [
            "achievement",
            "skill"
          ],
          "duration_minutes": 120,
          "context": {
            "skill": {
              "ctx": "payload.skill"
            }
          },
          "modifiers": [],
          "chance": 0.3
        }
      ],
      "text": {
        "chronicle": "{actor.name} {actor.gender:получил|получила} звание «{payload.new_rank_name}» в навыке «{payload.skill_name}»."
      }
    }
  ]
}
